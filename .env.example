# Copy to .env and adjust if needed. SQLite is local-only; no secrets here.
DATABASE_URL="file:./prisma/dev.db"

# Powers upload-time auto-categorization on the Inspiration Library page.
# Get a key at https://aistudio.google.com/apikey — without it, uploads
# fall back to manual categorization (no crash).
GEMINI_API_KEY=

# Fallback LLM provider when Gemini quota is exhausted.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — additional free-tier models.
# Free key: https://openrouter.ai/keys
# Comma-separate several keys to rotate across separate quota pools.
OPENROUTER_API_KEY=
