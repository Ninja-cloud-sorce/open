// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum InspirationType {
  IMAGE
  VIDEO
  URL
  NOTE
}

enum CategorizeStatus {
  PENDING
  DONE
  SKIPPED
  ERROR
}

model Collection {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  items     InspirationItem[]
}

model Tag {
  id    String            @id @default(cuid())
  name  String            @unique
  items InspirationItem[]
}

model InspirationItem {
  id               String            @id @default(cuid())
  type             InspirationType
  fileUrl          String?
  posterUrl        String?
  sourceUrl        String?
  title            String?
  description      String?
  typography       String?
  colorPalette     String?
  layoutStyle      String?
  motionStyle      String?
  designVocabulary String?
  aiPrompt         String?
  aiBrief          String?
  categorizeStatus CategorizeStatus @default(PENDING)
  categorizeError  String?
  collectionId     String?
  collection       Collection?      @relation(fields: [collectionId], references: [id])
  tags             Tag[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model InspirationSource {
  id         String   @id @default(cuid())
  name       String
  url        String
  faviconUrl String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}
