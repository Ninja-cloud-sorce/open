// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum InspirationType {
  IMAGE
  VIDEO
  URL
  NOTE
}

enum AnalysisStatus {
  PENDING
  ANALYZING
  DONE
  SKIPPED
  ERROR
}

model Collection {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  items     InspirationItem[]
}

model Tag {
  id    String            @id @default(cuid())
  name  String            @unique
  items InspirationItem[]
}

model InspirationItem {
  id           String            @id @default(cuid())
  type         InspirationType
  fileUrl      String?
  posterUrl    String?
  sourceUrl    String?
  title        String?
  description  String?
  collectionId String?
  collection   Collection?         @relation(fields: [collectionId], references: [id])
  tags         Tag[]
  analysis     InspirationAnalysis?
  promptBriefs PromptBrief[]
  projects     Project[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model InspirationAnalysis {
  id     String         @id @default(cuid())
  itemId String         @unique
  item   InspirationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  status AnalysisStatus @default(PENDING)
  error  String?

  title           String?
  description     String?
  primaryStyle    String?
  secondaryStyles String?
  confidence      Float?

  visualTone     String?
  designLanguage String?
  mood           String?
  industry       String?

  layoutStyle     String?
  gridSystem      String?
  spacingDensity  String?
  visualHierarchy String?

  typographyHeadline String?
  typographyBody     String?
  typographyWeight   String?
  typographyStyle    String?

  colorPalette String?

  illustrationStyle String?
  iconStyle         String?
  textures          String?
  lighting          String?
  depth             String?
  animationStyle    String?

  components      String?
  keywords        String?
  recommendedTags String?

  scoreMinimalism    Int?
  scorePremium       Int?
  scoreCreativity    Int?
  scoreTechnical     Int?
  scoreStorytelling  Int?
  scoreVisualDensity Int?
  scoreAccessibility Int?
  scoreConsistency   Int?

  aiNotes   String?
  embedding String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromptBrief {
  id              String   @id @default(cuid())
  title           String
  aesthetic       String?
  intent          String?
  audience        String?
  constraints     String?
  guardRails      String?
  negativePrompt  String?
  componentStyle  String?
  motionStyle     String?
  typographyStyle String?
  outputPrompt    String?
  references      InspirationItem[]
  heroImageSets   HeroImageSet[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum VariantStatus {
  PENDING
  GENERATING
  DONE
  ERROR
}

/** Which design rulebook a variant was generated under. */
enum DesignLane {
  IMPECCABLE
  TASTE_SKILL
}

/** The spine of the guided flow: one site being designed. */
model Project {
  id            String   @id @default(cuid())
  name          String
  serviceType   String?
  description   String?
  audience      String?
  designNotes   String?
  references    InspirationItem[]
  rounds        VariantRound[]
  heroImageSets HeroImageSet[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/** One narrowing pass. Round 1 is the 5+5 two-lane comparison; later rounds
 *  refine whichever variant was picked from the previous round. */
model VariantRound {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roundNumber     Int
  parentVariantId String?
  parentVariant   Variant?  @relation("RoundParent", fields: [parentVariantId], references: [id])
  variants        Variant[]
  createdAt       DateTime  @default(now())
}

model Variant {
  id           String        @id @default(cuid())
  roundId      String
  round        VariantRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  lane         DesignLane
  label        String
  styleName    String
  rationale    String?
  designTokens String?
  previewHtml  String?
  fullSiteHtml String?
  status       VariantStatus @default(PENDING)
  error        String?
  selected     Boolean       @default(false)
  favorite     Boolean       @default(false)
  order        Int           @default(0)
  childRounds  VariantRound[] @relation("RoundParent")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum HeroImageKind {
  BASE
  TREATMENT
}

model HeroImageSet {
  id            String       @id @default(cuid())
  briefId       String?
  brief         PromptBrief? @relation(fields: [briefId], references: [id])
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  /** The user's own answer to "what do you want to generate?" */
  subjectPrompt String?
  images        HeroImage[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model HeroImage {
  id          String        @id @default(cuid())
  setId       String
  set         HeroImageSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      HeroImage?    @relation("HeroImageTreatments", fields: [parentId], references: [id])
  treatments  HeroImage[]   @relation("HeroImageTreatments")
  kind        HeroImageKind
  label       String
  conceptName String
  prompt      String
  seed        Int
  imageUrl    String
  upscaledUrl String?
  favorite    Boolean       @default(false)
  applied     Boolean       @default(false)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
}

model InspirationSource {
  id         String   @id @default(cuid())
  name       String
  url        String
  faviconUrl String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}
