// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum InspirationType {
  IMAGE
  VIDEO
  URL
  NOTE
}

enum AnalysisStatus {
  PENDING
  ANALYZING
  DONE
  SKIPPED
  ERROR
}

model Collection {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  items     InspirationItem[]
}

model Tag {
  id    String            @id @default(cuid())
  name  String            @unique
  items InspirationItem[]
}

model InspirationItem {
  id           String            @id @default(cuid())
  type         InspirationType
  fileUrl      String?
  posterUrl    String?
  sourceUrl    String?
  title        String?
  description  String?
  collectionId String?
  collection   Collection?         @relation(fields: [collectionId], references: [id])
  tags         Tag[]
  analysis     InspirationAnalysis?
  promptBriefs PromptBrief[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model InspirationAnalysis {
  id     String         @id @default(cuid())
  itemId String         @unique
  item   InspirationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  status AnalysisStatus @default(PENDING)
  error  String?

  title           String?
  description     String?
  primaryStyle    String?
  secondaryStyles String?
  confidence      Float?

  visualTone     String?
  designLanguage String?
  mood           String?
  industry       String?

  layoutStyle     String?
  gridSystem      String?
  spacingDensity  String?
  visualHierarchy String?

  typographyHeadline String?
  typographyBody     String?
  typographyWeight   String?
  typographyStyle    String?

  colorPalette String?

  illustrationStyle String?
  iconStyle         String?
  textures          String?
  lighting          String?
  depth             String?
  animationStyle    String?

  components      String?
  keywords        String?
  recommendedTags String?

  scoreMinimalism    Int?
  scorePremium       Int?
  scoreCreativity    Int?
  scoreTechnical     Int?
  scoreStorytelling  Int?
  scoreVisualDensity Int?
  scoreAccessibility Int?
  scoreConsistency   Int?

  aiNotes   String?
  embedding String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromptBrief {
  id              String   @id @default(cuid())
  title           String
  aesthetic       String?
  intent          String?
  audience        String?
  constraints     String?
  guardRails      String?
  negativePrompt  String?
  componentStyle  String?
  motionStyle     String?
  typographyStyle String?
  outputPrompt    String?
  references      InspirationItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InspirationSource {
  id         String   @id @default(cuid())
  name       String
  url        String
  faviconUrl String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}
